# 示例环境配置文件，复制为 .env 后修改
# cp .env.example .env

SANDBOX_DEFAULT_TIMEOUT=10
SANDBOX_MAX_TIMEOUT=300
SANDBOX_DEFAULT_MEMORY_LIMIT=128m
SANDBOX_DEFAULT_CPU_LIMIT=1.0
SANDBOX_MAX_CPU_LIMIT=4.0
SANDBOX_PIDS_LIMIT=64
SANDBOX_TMPFS_SIZE=64m
SANDBOX_MAX_OUTPUT_BYTES=1048576
SANDBOX_MAX_CODE_LENGTH=102400

# 沙盒模式: auto(自动检测) | docker | subprocess
SANDBOX_MODE=auto

# Docker daemon 地址（容器部署时设置为 unix:///var/run/docker.sock）
DOCKER_HOST=unix:///var/run/docker.sock

# 宿主机上代码临时目录的绝对路径（仅 Docker-out-of-Docker 部署时设置，与 docker-compose.yml 卷挂载一致）
HOST_CODE_DIR=/tmp/codesandbox_code
